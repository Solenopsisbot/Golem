// The End: shoot the crystals, then the dragon.

/// Shoot a moving target where it is going to BE, not where it is.
///
/// A fully drawn arrow travels roughly 53 blocks a second, so a dragon 40 blocks away gets most of a
/// second to move before the arrow arrives. Aiming straight at it is why 240 arrows put 2.5 damage on
/// a dragon and the rest on the floor. This samples the target twice to get its velocity, leads it by
/// the flight time, and adds lift for the drop. Returns false when the target is not in sight.
script lead_shot(kind: string = "ender_dragon", radius: float = 140): bool {
  let a = nearest(kind, radius)
  if (a == none) return false
  let p1 = a.pos
  wait 250ms
  let b = nearest(kind, radius)
  if (b == none) return false
  let p2 = b.pos
  // 250 ms of travel scaled to blocks per second.
  let vx = (p2.x - p1.x) * 4.0
  let vy = (p2.y - p1.y) * 4.0
  let vz = (p2.z - p1.z) * 4.0
  let d = p2.dist(here)
  let t = d / 53.0
  equip("bow")
  look_at(vec(p2.x + vx * t, p2.y + vy * t + d * 0.05, p2.z + vz * t))
  use_hold(25)
  use_release()
  return true
}

/// One bow shot at an entity, aimed `lift` blocks above it for the arrow's drop.
script aimed_shot(e: entity, lift: float = 0) {
  equip("bow")
  look_at(vec(e.pos.x, e.pos.y + lift, e.pos.z))
  use_hold(25)
  use_release()
}

/// Shoot every end crystal in sight from the ground below its pillar. The tallest pillars are out of
/// bow range from the ground: pillar up with blocks for those. Returns how many crystals were destroyed.
script shoot_crystals(max_per: int = 8): int {
  if (inventory.count("bow") < 1) fail "no bow"
  let killed = 0
  let crystals = find_entities("end_crystal", radius: 160)
  log "${len(crystals)} crystals in sight"
  for (c of crystals) {
    try { timeout 2m { goto_xz(c.pos.x, c.pos.z, reach: 16) } } catch (e) { log "approach: ${e.kind} ${e.message}" }
    let shots = 0
    while (shots < max_per) {
      let still = false
      for (a of find_entities("end_crystal", radius: 80)) { if (a.id == c.id) still = true }
      if (still == false) { killed = killed + 1; log "crystal ${c.id} destroyed"; break }
      let d = max(abs(c.pos.x - here.x), abs(c.pos.z - here.z))
      let up = c.pos.y - here.y
      aimed_shot(c, lift: 0.5 + d * 0.08 + up * 0.05)
      shots = shots + 1
      wait 900ms
    }
  }
  return killed
}

/// Fight the dragon: melee when it perches on the fountain, arrows when it flies within range,
/// otherwise wait by the fountain. Returns true when no dragon is left.
script fight_dragon(): bool {
  repeat (700) {
    let d = nearest("ender_dragon", radius: 250)
    if (d == none) { log "no dragon in sight"; return true }
    if (food < 14) { try { eat_something() } catch (e) { log "eat: ${e.kind}" } }
    let near = max(abs(d.pos.x - here.x), abs(d.pos.z - here.z))
    if (d.pos.y < here.y + 6 && near < 10) {
      try { attack(d, timeout: 8s) } catch (e) { log "melee: ${e.kind}" }
    } else {
      if (near < 70) {
        // Lead it: a circling dragon is never where it was when you drew.
        if (lead_shot() == false) aimed_shot(d, lift: 1 + near * 0.06)
      } else {
        try { timeout 30s { goto_xz(0, 0, reach: 6) } } catch (e) { log "to the fountain: ${e.kind}" }
      }
    }
    wait 1s
  }
  return nearest("ender_dragon", radius: 250) == none
}

/// Crystals first, then the dragon. Returns true when the dragon is dead.
script beat_dragon(): bool {
  shoot_crystals()
  return fight_dragon()
}
