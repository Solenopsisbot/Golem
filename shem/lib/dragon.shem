// The End: shoot the crystals, then the dragon.
//
// The generic fighting pieces (kit_up, eat_if_hurt, lead_shot, back_off) live in lib/combat, and the
// End's own arithmetic - firing positions, cages, perch distance - lives in lib/end. This file is
// just the crystals-then-boss shape, in one call.
use "lib/combat"
use "lib/end"

/// Shoot every reachable end crystal, nearest first. Returns how many went down.
///
/// Walks to the standoff `lib/end` computes and fires with `shoot_static`, which solves the shot by
/// simulating the arrow. Both of those replace things that were wrong here for a long time: this
/// script used to approach to a flat 16 blocks and aim with a fudge factor of roughly `0.08 * range`,
/// which is right at about one distance and misses everywhere else, and from 16 blocks out the
/// pillar is in the way regardless of aim. It reported "0 destroyed" after a full quiver and read as
/// the crystals being caged.
///
/// Skips anything still standing after `max_per` shots rather than emptying the quiver into bars.
script shoot_crystals(max_per: int = 4): int {
  in_the_end()
  if (inventory.count("bow") < 1) fail "no bow"
  let killed = 0
  let crystals = find_entities("end_crystal", radius: 200)
  log "${len(crystals)} crystals standing"
  for (c of crystals) {
    if (inventory.count("arrow") < 4) { log "out of arrows"; break }
    let before = len(find_entities("end_crystal", radius: 200))
    try { pop_crystal(c, shots: max_per) } catch (e) { log "crystal ${c.id}: ${e.kind} ${e.message}" }
    if (len(find_entities("end_crystal", radius: 200)) < before) {
      killed = killed + 1
      log "crystal down at ${c.pos} (${killed} this pass)"
    } else {
      log "crystal at ${c.pos} survived ${max_per} shots - caged, or out of reach"
    }
  }
  return killed
}

/// Fight the dragon. Returns true when it is dead.
///
/// The perch is the whole fight. A perched dragon holds still and takes full sword damage; a circling
/// one mostly eats arrows. So this waits at the fountain and swings when it comes down, rather than
/// chasing it.
///
/// Swings with `melee_while`, never `attack`. The dragon's parent entity ignores damage outright -
/// only its parts take any - so `attack` on it registers nothing at all and looks like a miss. That
/// is what this script used to do, which meant calling it did nothing but get you killed.
script fight_dragon(rounds: int = 400): bool {
  in_the_end()
  repeat (rounds) {
    let d = nearest("ender_dragon", 250)
    if (d == none) { log "dragon gone"; return true }
    if (health < 10) { try { back_off(d, 20) } catch (e) { log "retreat: ${e.kind}" } }
    else {
      eat_if_hurt(16)
      let cloud = nearest("area_effect_cloud", 8)
      if (cloud != none) {
        // Breath outlasts the walk out of it; a pearl is instant and costs 5.
        if (inventory.count("ender_pearl") > 0 and health >= 8) {
          try { pearl_to(pos(int(here.x + (here.x - cloud.pos.x)), int(here.y), int(here.z + (here.z - cloud.pos.z)))) }
          catch (e) { try { back_off(cloud, 14) } catch (e2) { log "cloud: ${e2.kind}" } }
        } else { try { back_off(cloud, 14) } catch (e) { log "cloud: ${e.kind}" } }
      } else if (dragon_offset() < 12 and d.pos.y < 71) {
        // Perched. Walk to the fountain FLOOR, never to d.pos - a mid-air goal makes Baritone tower
        // cobble toward it, and the fight ends as fall damage instead of as a dead dragon.
        try { timeout 8s { goto(pos(0, 63, 0), reach: 5) } } catch (e) { log "close: ${e.kind}" }
        try { melee_while(d, max_ms: 5000, stop_below_health: 10) } catch (e) { log "melee: ${e.kind}" }
      } else if (inventory.count("arrow") > 0 and d.dist < 45) {
        try { lead_shot("ender_dragon", 45, 3) } catch (e) { log "shot: ${e.kind}" }
      } else {
        // Do NOT camp the fountain waiting for it to land. Measured: a bot standing still at (0,63,0)
        // holds the dragon in DragonPhase 1 (STRAFE_PLAYER) indefinitely - 45 samples out of 45 over
        // ninety seconds - and holding pattern is the only phase that rolls for a landing. Strafe
        // only ends when it closes to about ten blocks and fires, and it circles at y 85, so from the
        // fountain floor it never gets close enough to finish. Camping the perch is what prevents the
        // perch.
        //
        // So wait out at range instead. It drops the target, returns to holding pattern, and with one
        // crystal left rolls roughly one in four per circuit to come down.
        if (dragon_offset() > 20 and d.dist > 40) {
          wait 2s
        } else {
          try { timeout 20s { goto_xz(int(here.x * 3), int(here.z * 3), reach: 6) } } catch (e) { log "back off: ${e.kind}" }
        }
      }
    }
    wait 500ms
  }
  return nearest("ender_dragon", 250) == none
}

/// Crystals first, then the dragon, in one call. Returns true when the dragon is dead.
///
/// Crystals first is not a preference: each one still standing heals the dragon faster than a bow
/// hurts it, so time spent on the dragon while any are up is time spent for nothing. Caged ones on
/// the ring are the exception worth knowing - they only heal within 32 blocks, so a dragon perched on
/// the fountain is out of their reach and they can simply be left.
script beat_dragon(): bool {
  in_the_end()
  let down = shoot_crystals()
  log "cleared ${down} crystals; ${len(find_entities("end_crystal", radius: 200))} left"
  return fight_dragon()
}
