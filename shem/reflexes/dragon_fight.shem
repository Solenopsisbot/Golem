use "lib/combat"
use "lib/dragon"

/// Fight the ender dragon in real time, between the mind's turns. Off by default.
///
/// A planning turn takes 15-45 seconds. The dragon kills an armoured bot in two hits. No amount of
/// thinking survives that gap, so the fighting has to happen down here on the reflex tick: heal when
/// hurt, break contact when losing, swing when it is in reach, and lead it with the bow when it is
/// not. The mind's job during a boss fight is supply and position, not swings.
///
/// Every height test below is anchored to the island FLOOR (y 63), never to `here.y`. The first
/// version asked "is the dragon below me?" against its own feet, and Baritone answers a mid-air goal
/// by towering cobblestone toward it: each block placed raised `here.y`, which kept the melee branch
/// true, which placed another block. Tester spent an entire fight climbing a pillar with 320 arrows
/// unspent, then fled off the top of it at 6 hp and died to fall damage at y 38. Stay on the ground.
reflex dragon_fight priority 93 on tick when dimension == "the_end" and nearest("ender_dragon", 120) != none {
  if (here.y > 68) {
    // Standing on a tower I should never have built. Getting down comes before everything else: a
    // fight at height ends as fall damage, not as a dead dragon. goto walks, it does not jump off.
    try { goto(pos(0, 63, 0), reach: 6, timeout: 10s) } catch (e) { log "descend: ${e.kind}" }
  } else {
    // Eat early. A dragon hit lands for about ten through diamond, so waiting until 12 means dying
    // at full-ish health to a single swipe while the food is still going down.
    eat_if_hurt(16)
    // Dragon breath pools where it perches, and standing in it is the other way this fight is lost:
    // it ticks for more than the food heals. Treat a cloud within five blocks as a reason to move.
    let cloud = nearest("area_effect_cloud", 6)
    let crystal = nearest("end_crystal", 120)
    let d = nearest("ender_dragon", 120)
    if (cloud != none and health <= 16) {
      back_off(cloud, 12)
    } else if (crystal != none) {
      // Crystals first, always. Every one still standing heals the dragon faster than a bow can hurt
      // it, so shooting the dragon while any remain is throwing arrows away.
      //
      // Walk to the FOOT of the pillar before firing. Shooting one from where you happen to be
      // standing does not work and it is not a matter of aim: the crystal sits 20 to 45 blocks up on
      // a one-block apex, so from forty blocks out the arrow arrives at a shallow angle and clips the
      // pillar, and past `shoot_at`'s 64-block limit the body refuses the shot outright without ever
      // firing. Tester spent 56 arrows this way for nothing across two runs before working out - on
      // its own, in a script comment - that the answer is to stand underneath and fire almost
      // straight up, where the pillar cannot be in the way and the range is just the height.
      // HORIZONTAL distance decides whether to walk, never `crystal.dist`. That field is 3D, and a
      // crystal 23 blocks straight overhead reads as 23 away while you are already standing on the
      // pillar's foot - so a 3D test walks you to a pillar you are stood on, forever, and never fires
      // a shot. This is the same mistake in the same place twice: it is what made Tester read
      // reachable crystals as "caged" in r4, and I then wrote it into this reflex while fixing that.
      let chor = max(abs(crystal.pos.x - here.x), abs(crystal.pos.z - here.z))
      // Stand BACK by about the crystal's height, never underneath it.
      //
      // Firing from the pillar's foot cannot work, and not because of aim: the column is in the way.
      // From four blocks out, the line to a crystal seventeen up passes through the obsidian at about
      // y 10, and no arc saves it - at eighty degrees a bow arrow is only twelve blocks high after two
      // blocks of travel, still inside the pillar. Run 35 put its whole quiver into the rock at y 74
      // under a crystal at y 80, tightly grouped, six blocks short.
      //
      // The sight line clears the edge when d > (h - 1.6) * r / 2, and End pillars run about two
      // blocks in radius, so the standoff is roughly the height itself: eighteen blocks out for a
      // crystal seventeen up, forty-two for one forty-one up. Both sit inside shoot_at's 64.
      let dy = max(1.0, crystal.pos.y - here.y)
      let so = min(52.0, max(14.0, 1.2 * dy))
      let cdx = here.x - crystal.pos.x
      let cdz = here.z - crystal.pos.z
      let clen = max(1.0, max(abs(cdx), abs(cdz)))
      if (chor < so - 8 or chor > so + 12) {
        // Walk out along the line we are already on, to the ring where the shot clears the pillar.
        try { timeout 8s { goto_xz(int(crystal.pos.x + cdx / clen * so), int(crystal.pos.z + cdz / clen * so), reach: 4) } }
        catch (e) { log "to pillar: ${e.kind}" }
      } else if (crystal.dist < 6) {
        // Close enough to swing: this is also how a caged crystal comes down, since iron bars stop
        // arrows entirely and several pillars on a fresh island are caged.
        try { melee_while(crystal, max_ms: 2000) } catch (e) { log "crystal melee: ${e.kind}" }
      } else {
        try { shoot_at(crystal, shots: 3) } catch (e) { log "crystal: ${e.kind}" }
      }
    } else if (d != none and inventory.count("arrow") < 24) {
      // Nearly dry, and no crystal in sight. Arrows are the only ranged answer here, so go and pick
      // the spent ones up rather than keep firing the last of them.
      try { collect_drops(20) } catch (e) { log "collect: ${e.kind}" }
    } else if (d != none and max(abs(here.x), abs(here.z)) < 30) {
      // No crystal visible - but that is not the same as no crystal standing. The client's entity
      // list empties after every death and refills as chunks come back, so `nearest(end_crystal) ==
      // none` is usually just blindness, and answering it by shooting the dragon burns the quiver on
      // the one target that heals faster than a bow can hurt it.
      //
      // So walk out to the pillar ring and look again. Gated on actually being near the middle,
      // which makes it self-limiting: once out at the ring, either a crystal is visible and the
      // branch above takes it, or there genuinely are none left and the perch-melee branch does the
      // killing - which is how the dragon dies in vanilla anyway.
      try { timeout 10s { goto_xz(38, 0, reach: 6) } } catch (e) { log "reacquire: ${e.kind}" }
    } else if (d != none) {
      // How far the dragon is from the fountain, horizontally. It perches on the fountain at
      // (0, 63, 0) and nowhere else, so this - not its distance from me - is what says "perched".
      let off = max(abs(d.pos.x), abs(d.pos.z))
      if (health <= 11) {
        // Losing the trade. Break contact along the ground; dying costs the gear and the position.
        // Eleven, not six: below that a single hit finishes the job before the retreat resolves.
        back_off(d, 18)
      } else if (d.pos.y < 71 and off < 12) {
        // It has come down to perch. That is the whole fight: a perched dragon holds still and takes
        // full sword damage, where arrows at a circling one mostly miss. Walk to the fountain FLOOR -
        // never to d.pos, which is its body several blocks up, and a mid-air goal builds the tower.
        try { goto(pos(0, 63, 0), reach: 5, timeout: 6s) } catch (e) { log "close: ${e.kind}" }
        // The body swings on the real cooldown and resolves the dragon's parts; the parent entity
        // ignores damage, which is why hitting "the dragon" from a script can register nothing.
        try { melee_while(d, max_ms: 5000, stop_below_health: 11) }
        catch (e) { if (e.kind == "unsupported") { try { attack(d, timeout: 6s) } catch (e2) { log "melee: ${e2.kind}" } } else { log "melee: ${e.kind}" } }
      } else if (inventory.count("arrow") > 0 and d.dist < 45) {
        // Out of reach but close: lead it. Aiming where it already is puts arrows in the floor.
        // One call, four arrows: the body runs the aiming loop, so there is nothing to interleave.
        //
        // 45 blocks, not 140. A dragon at a hundred blocks is a hundred blocks of arc over an island
        // that runs out: every one of those arrows was found lying at y -29, y -52, a hundred and
        // eighty blocks from anything, falling through the void. And the shot is pointless even when
        // it lands - a standing crystal heals the dragon faster than a bow hurts it, so the only
        // reason to be firing at the dragon at all is that no crystal is left.
        try { lead_shot("ender_dragon", 45, 4) } catch (e) { log "shot: ${e.kind}" }
        // Spent arrows are lying around and the quiver is finite; sweep them up while it is far off.
        if (inventory.count("arrow") < 60) {
          try { collect_drops(14) } catch (e) { log "collect: ${e.kind}" }
        }
      }
    }
  }
}
